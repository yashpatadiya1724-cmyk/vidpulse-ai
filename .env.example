# App
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Backend
DATABASE_URL=postgresql+asyncpg://vidpulse:secret@localhost:5432/vidpulse
MONGODB_URL=mongodb://localhost:27017/vidpulse_analysis
REDIS_URL=redis://localhost:6379
SECRET_KEY=changeme32charslongsecretkeyhere
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage (use MinIO locally or AWS S3)
S3_BUCKET_NAME=vidpulse-videos
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_ENDPOINT_URL=http://localhost:9000

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_VIDEO_TOPIC=video-processing

# AI Models
MODEL_WEIGHTS_PATH=./weights/
DEVICE=cpu
BATCH_SIZE=8
FRAMES_PER_SECOND=2
ATTENTION_THRESHOLD=0.45

# DB
DB_PASSWORD=secret
